#!/usr/bin/perl

use strict;
use warnings;
use 5.010;

use Getopt::Long;
use Pod::Usage;
use meon::Web::Search;

exit main();

sub main {
    my $help;
    my $dst_domain;
    my $dry_run;
    GetOptions(
        'help|h'     => \$help,
        'hostname=s' => \$dst_domain,
        'dry-run!'   => \$dry_run,
    ) or pod2usage;
    pod2usage if $help;
    pod2usage unless defined $dst_domain;

    my $mws = meon::Web::Search->new( hostname => $dst_domain, );

    $mws->do_indexing( dry_run => $dry_run );

    return 0;
}

=head1 NAME

meon-web-generate-opensearch - generate opensearch search data

=head1 SYNOPSIS

    meon-web-generate-opensearch --hostname domain
        --hostname domain   domain of the web to generate search index
    --dry-run           populate the working index without switching alias

=head1 DESCRIPTION


=cut
